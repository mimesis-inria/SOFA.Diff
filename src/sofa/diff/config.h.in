#pragma once

#include <sofa/config.h>

// adding SOFA namespace to ease using SOFA classes within the plugin
using namespace sofa;

#define SOFADIFF_VERSION @PROJECT_VERSION@

#cmakedefine SOFA_DIFF_BUILD_GUI_COMPONENTS

#ifdef SOFA_BUILD_SOFA_DIFF
#  define SOFA_TARGET @PROJECT_NAME@
#  define SOFA_SOFADIFF_API SOFA_EXPORT_DYNAMIC_LIBRARY
#else
#  define SOFA_SOFADIFF_API SOFA_IMPORT_DYNAMIC_LIBRARY
#endif

namespace sofadiff
{
    constexpr const char* MODULE_NAME = "@PROJECT_NAME@";
    constexpr const char* MODULE_VERSION = "@PROJECT_VERSION@";
}