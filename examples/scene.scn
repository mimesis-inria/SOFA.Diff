<?xml version="1.0"?>
<Node name="Root" gravity="0 -10 0" time="0" animate="0" bbox="-1 -3 -1 4 3 1" dt="0.001">

    <Node name="Plugins">
        <RequiredPlugin name="SofaDiff" pluginName="SofaDiff"/>
        <RequiredPlugin name="Sofa.Component.Visual"/> <!-- Needed to use components [VisualStyle] -->
        <RequiredPlugin name="Sofa.Component.LinearSolver.Iterative"/> <!-- Needed to use components [CGLinearSolver] -->
        <RequiredPlugin name="Sofa.Component.ODESolver.Backward"/> <!-- Needed to use components [NewtonRaphsonSolver, StaticSolver] -->
        <RequiredPlugin name="Sofa.Component.StateContainer"/> <!-- Needed to use components [MechanicalObject] -->
        <RequiredPlugin name="Sofa.Component.Mass"/> <!-- Needed to use components [UniformMass] -->
        <RequiredPlugin name="Sofa.Component.MechanicalLoad"/> <!-- Needed to use components [ConstantForceField] -->
        <RequiredPlugin name="Sofa.Component.Constraint.Projective"/> <!-- Needed to use components [FixedProjectiveConstraint] -->
        <RequiredPlugin name="Sofa.Component.SolidMechanics.Spring"/> <!-- Needed to use components [SpringForceField] -->
        <RequiredPlugin name="Sofa.Component.Mapping.NonLinear"/> <!-- Needed to use components [RigidMapping] -->
    </Node>

    <DefaultAnimationLoop/>
    <VisualStyle displayFlags="showBehavior showBehaviorModels showForceFields showMappings"/>
    <GradientDescentController name="controller" trainableParameters="Objects/spring1.name Objects/spring2.name"/>

    <Node name="FixedTop">
        <MechanicalObject template="Vec3d" name="fixed" position="0 2 0"/>
    </Node>

    <Node name="FixedRight">
        <MechanicalObject template="Vec3d" name="fixed" position="3 1 0"/>
    </Node>

    <Node name="Objects">
        <NewtonRaphsonSolver name="newton" maxNbIterationsNewton="100" maxNbIterationsLineSearch="1" warnWhenLineSearchFails="false"/>
        <StaticSolver newtonSolver="@newton" name="static"/>
        <!--
        <EulerImplicitSolver name="implicit"/>
        -->
        <CGLinearSolver template="GraphScattered" name="linear solver" printLog="0" iterations="1000" tolerance="1e-5" threshold="1e-5"/>

        <MechanicalObject template="Rigid3d" name="dofs" position="1.5 0 0  0 0 0 1"/>
        <!-- <MechanicalObject template="Rigid3d" name="dofs" position="0.893734 -0.488142 0 0 0 0.073713 0.997280"/> -->
        <UniformMass template="Rigid3d" name="uniformMass" totalMass="1.0"/>

        <Node name="Top">
            <MechanicalObject template="Vec3d" name="top" position="0 0.5 0"/>
            <RigidMapping input="@.."/>
            <ConstantForceField forces="0.00 0 0"/>
        </Node>
        <ParameterizedSpringForceField name="spring1" object1="@../FixedTop" object2="@Top" indices1="0" indices2="0" length="2" stiffness="100"/>

        <Node name="Right">
            <MechanicalObject template="Vec3d" name="top" position="0.5 0 0"/>
            <RigidMapping/>
        </Node>
        <ParameterizedSpringForceField name="spring2" object1="@../FixedRight" object2="@Right" indices1="0" indices2="0" length="2" stiffness="100"/>

        <Node name="Bottom">
            <MechanicalObject template="Vec3d" name="bottom" position="0 -0.5 0"/>
            <RigidMapping/>
        </Node>
    </Node>

    <Node name="Error">
        <MechanicalObject template="Vec1d" name="error" position="0"/>
        <DistanceToPlaneCost template="Vec3d" input="@../Objects/Bottom" planeNormal="2 0 0" planePoint="0 0 0"/>
    </Node>
</Node>
