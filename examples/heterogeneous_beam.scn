<?xml version="1.0"?>
<Node name="Root" gravity="0 -9.8 0" time="0" animate="0" bbox="-2 -20 -4 42 4 4" dt="0.05">

    <Node name="Plugins">
        <RequiredPlugin name="SofaDiff" pluginName="SofaDiff"/>
        <RequiredPlugin name="Sofa.Component.Visual"/> <!-- Needed to use components [VisualStyle] -->
        <RequiredPlugin name="Sofa.Component.LinearSolver.Iterative"/> <!-- Needed to use components [CGLinearSolver] -->
        <RequiredPlugin name="Sofa.Component.LinearSolver.Direct"/> <!-- Needed to use components [SparseLDLSolver] -->
        <RequiredPlugin name="Sofa.Component.ODESolver.Backward"/> <!-- Needed to use components [NewtonRaphsonSolver, StaticSolver] -->
        <RequiredPlugin name="Sofa.Component.StateContainer"/> <!-- Needed to use components [MechanicalObject] -->
        <RequiredPlugin name="Sofa.Component.Mass"/> <!-- Needed to use components [UniformMass] -->
        <RequiredPlugin name="Sofa.Component.MechanicalLoad"/> <!-- Needed to use components [ConstantForceField] -->
        <RequiredPlugin name="Sofa.Component.Constraint.Projective"/> <!-- Needed to use components [FixedProjectiveConstraint] -->
        <RequiredPlugin name="Sofa.Component.SolidMechanics.Spring"/> <!-- Needed to use components [SpringForceField] -->
        <RequiredPlugin name="Sofa.Component.Topology.Container.Grid"/> <!-- Needed to use components [RegularGridTopology] -->
        <RequiredPlugin name="Sofa.Component.Engine.Select"/> <!-- Needed to use components [BoxROI] -->
        <RequiredPlugin name="Sofa.Component.SolidMechanics.FEM.Elastic"/> <!-- Needed to use components [HexahedronFEMForceField] -->
        <RequiredPlugin name="Sofa.Component.Mapping.Linear"/> <!-- Needed to use components [BarycentricMapping] -->
        <RequiredPlugin name="Sofa.Component.Mapping.NonLinear"/> <!-- Needed to use components [DistanceFromTargetMapping] -->
        <RequiredPlugin name="Sofa.Component.Topology.Container.Dynamic"/> <!-- Needed to use components [TetrahedronSetGeometryAlgorithms,TetrahedronSetTopologyContainer,TetrahedronSetTopologyModifier] -->
        <RequiredPlugin name="Sofa.Component.Topology.Mapping"/> <!-- Needed to use components [Hexa2TetraTopologicalMapping] -->
        <RequiredPlugin name="Sofa.GL.Component.Rendering3D"/> <!-- Needed to use components [OglModel] -->
    </Node>

    <GradientDescentOptimizationLoop timesteps="30"/>
    <DifferentiableAnimationLoop computeBoundingBox="false"/>
    <VisualStyle displayFlags="showBehavior showBehaviorModels showForceFields hideMappings"/>

    <Node name="Parameters">
        <TrainableParameterVector name="youngModulus1" value="50000" learningRate="1000000"/>
        <TrainableParameterVector name="youngModulus2" value="50000" learningRate="1000000"/>
        <TrainableParameterVector name="youngModulus3" value="50000" learningRate="1000000"/>
        <TrainableParameterVector name="youngModulus4" value="50000" learningRate="1000000"/>
    </Node>

    <Node name="Topology">
        <RegularGridTopology name="grid" min="0 -1.5 -1.5" max="40 1.5 1.5" n="41 4 4"/>
    </Node>

    <Node name="Physics">
        <SparseLDLSolver template="CompressedRowSparseMatrixd" name="solver"/>
        <NewtonRaphsonSolver name="newton" maxNbIterationsNewton="100" maxNbIterationsLineSearch="1" warnWhenLineSearchFails="false"/>
<!--        <StaticSolver newtonSolver="@newton" name="static"/>-->
<!--        <StaticAdjointSolver name="adjoint"/>-->
        <EulerImplicitSolver />
        <ImplicitAdjointSolver name="adjoint"/>

        <Node name="Beam">
            <TetrahedronSetGeometryAlgorithms/>
            <TetrahedronSetTopologyModifier/>
            <TetrahedronSetTopologyContainer name="topology" position="@/Topology/grid.position"/>
            <Hexa2TetraTopologicalMapping input="@/Topology/grid" output="@topology" swapping="true"/>

            <MechanicalObject template="Vec3d" name="state" position="@/Topology/grid.position"/>
            <UniformMass template="Vec3d" name="mass" totalMass="600"/>

            <BoxROI name="Young1" box="-0.1 -2.1 -2.1 10.1 2.1 2.1"  drawBoxes="false"/>
            <BoxROI name="Young2" box="9.9 -2.1 -2.1 20.1 2.1 2.1"  drawBoxes="false"/>
            <BoxROI name="Young3" box="19.9 -2.1 -2.1 30.1 2.1 2.1"  drawBoxes="false"/>
            <BoxROI name="Young4" box="29.9 -2.1 -2.1 40.1 2.1 2.1"  drawBoxes="false"/>

            <Node name="SubTopo1">
                <TetrahedronSetTopologyContainer name="topology" tetrahedra="@../Young1.tetrahedraInROI"/>

                <MechanicalObject template="Vec3d" name="state" position="@../state.position"/>
                <ParameterizedTetrahedronFEMForceField
                        name="elasticity"
                        youngModulus="@/Parameters/youngModulus1.value"
                        poissonRatio="0.45"
                        updateStiffness="true"
                />
                <IdentityMapping />
            </Node>
            <Node name="SubTopo2">
                <TetrahedronSetTopologyContainer name="topology" tetrahedra="@../Young2.tetrahedraInROI"/>

                <MechanicalObject template="Vec3d" name="state" position="@../state.position"/>
                <ParameterizedTetrahedronFEMForceField
                        name="elasticity"
                        youngModulus="@/Parameters/youngModulus2.value"
                        poissonRatio="0.45"
                        updateStiffness="true"
                />
                <IdentityMapping />
            </Node>
            <Node name="SubTopo3">
                <TetrahedronSetTopologyContainer name="topology" tetrahedra="@../Young3.tetrahedraInROI"/>
                <MechanicalObject template="Vec3d" name="state" position="@../state.position"/>
                <ParameterizedTetrahedronFEMForceField
                        name="elasticity"
                        youngModulus="@/Parameters/youngModulus3.value"
                        poissonRatio="0.45"
                        updateStiffness="true"
                />
                <IdentityMapping />
            </Node>
            <Node name="SubTopo4">
                <TetrahedronSetTopologyContainer name="topology" tetrahedra="@../Young4.tetrahedraInROI"/>
                <MechanicalObject template="Vec3d" name="state" position="@../state.position"/>
                <ParameterizedTetrahedronFEMForceField
                        name="elasticity"
                        youngModulus="@/Parameters/youngModulus4.value"
                        poissonRatio="0.45"
                        updateStiffness="true"
                />
                <IdentityMapping />
            </Node>

            <Node name="Visual">
                <Node name="VisualGel1" activated="1">
                    <TriangleSetTopologyContainer name="Container" triangles="@/Physics/Beam/Young1.trianglesInROI"/>
                    <OglModel color="0.470588235 0.368627451 0.941176471 0.5" name="visualModel"/>
                    <BarycentricMapping name="VisualMapping"/>
                </Node>
                <Node name="VisualGel2" activated="1">
                    <TriangleSetTopologyContainer name="Container" triangles="@/Physics/Beam/Young2.trianglesInROI"/>
                    <OglModel color="0.862745098 0.149019608 0.498039216 0.5" name="visualModel"/>
                    <BarycentricMapping name="VisualMapping"/>
                </Node>
                <Node name="VisualGel3" activated="1">
                    <TriangleSetTopologyContainer name="Container" triangles="@/Physics/Beam/Young3.trianglesInROI"/>
                    <OglModel color="0.392156863 0.560784314 1 0.5" name="visualModel"/>
                    <BarycentricMapping name="VisualMapping"/>
                </Node>
                <Node name="VisualGel4" activated="1">
                    <TriangleSetTopologyContainer name="Container" triangles="@/Physics/Beam/Young4.trianglesInROI"/>
                    <OglModel color="0.996078431 0.380392157 0 0.5" name="visualModel"/>
                    <BarycentricMapping name="VisualMapping"/>
                </Node>
            </Node>

            <Node name="BoundaryCondition">
                <BoxROI name="region" box="19.9 -2 -2   20.1 2 2"/>
                <FixedProjectiveConstraint indices="@region.indices"/>
            </Node>

            <Node name="Markers">
                <MechanicalObject template="Vec3d" name="state" position="0 0 0  10 0 0  30 0 0  40 0 0"/>
<!--                <MechanicalObject template="Vec3d" name="state" position="0 0 0  10 0 0"/>-->
                <BarycentricMapping/>
            </Node>
        </Node>
    </Node>


    <Node name="Loss">
        <Node name="Targets">
<!--            <MechanicalObject template="Vec3d" name="state" position="0.2 -2.6 0.0  10.0 -0.8 0.0  29.5 -2.9 0.0  38.5 -7.4 0.0" showObject="true" drawMode="1" showObjectScale="0.5"/>-->
<!--            Dynamic (30 timesteps with dt=0.05, target parameters = 20k, 100k, 50k, 100k)-->
            <MechanicalObject template="Vec3d" name="state" position="0.80 -5.00 0.08  10.10 -1.32 0.02  29.56 -2.71 0.02  38.46 -7.30 0.06" showObject="true" drawMode="1" showObjectScale="0.5"/>
        </Node>
        <Node name="Distances">
            <MechanicalObject template="Vec1d" name="output" position="0"/>
            <DistanceFromTargetMapping input="@Physics/Beam/Markers" targetPositions="@../Targets/state.position"/>
            <Node name="MSE">
                <LossState name="state"/>
                <MeanSquaredErrorMapping/>
            </Node>
        </Node>
    </Node>
</Node>
